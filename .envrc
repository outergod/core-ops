export CODEX_HOME=$PWD/.codex

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" \
    "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

use flake

export CORE_OPS_VERIFY_VM_HOST=ulthar
export CORE_OPS_VERIFY_CORE_OPS_BIN=target/debug/core-ops
export CORE_OPS_VERIFY_NETWORK_MODE=dhcp
export CORE_OPS_VERIFY_IGNITION_TEMPLATE=infra/ignition/dhcp.bu.tpl
