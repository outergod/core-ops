[Unit]
Description=Nextcloud Postgres database
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:16
ContainerName=nextcloud-db
Network=nextcloud.network
Volume=nextcloud-db-data.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_USER=nextcloud
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/nextcloud-db-password
Secret=nextcloud-db-password,target=/run/secrets/nextcloud-db-password

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
