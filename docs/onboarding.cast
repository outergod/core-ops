[0.023971, "o", "op@example $ core-ops plan --source-repo examples/03-immich --host example\r\n"]
[0.108347, "o", "\u001b[1m\u001b[37mPlan for host example @ (stateless) (first run)\u001b[0m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\u001b[1m\u001b[37m\u001b[32m[+]\u001b[0m Create \u2022 10\u001b[0m\n\n\u001b[32m[+]\u001b[0m volume/immich-db-data.volume\t\t\tmissing\n    \u0394 content\n      --- previous\n      +++ desired\n      + [Unit]\n      + Description=Immich database data volume\n      + \n      + [Volume]\n      + VolumeName=immich-db-data\n\n\u001b[32m[+]\u001b[0m network/immich-internal.network\t\t\tmissing\n    \u0394 content\n      --- previous\n      +++ desired\n      + [Unit]\n      + Description=Internal network: server + db + redis + ML\n      + \n      + [Network]\n      + NetworkName=immich-internal\n      + Subnet=192.0.2.0/24\n\n\u001b[32m[+]\u001b[0m container/immich-database.container\t\t\tmissing\n    requires\n      \u251c\u2500 \u001b[32m[+]\u001b[0m network/immich-internal.network\t\tmissing\n      \u2514\u2500 \u001b[32m[+]\u001b[0m volume/immich-db-data.volume\t\tmissing\n    \u0394 content (21 additions)\n      + [Unit]\n      + Description=Immich Postgres + pgvecto.rs database\n      + After=network-online.target\n      + Wants=network-online.target\n      + \n      + [Container]\n      ...\n\n\u001b[32m[+]\u001b[0m volume/immich-ml-cache.volume\t\t\tmissing\n    \u0394 content\n      --- previous\n      +++ desired\n      + [Unit]\n      + Description=Immich ML model cache\n      + \n      + [Volume]\n      + VolumeName=immich-ml-cache\n\n\u001b[32m[+]\u001b[0m container/immich-ml.container\t\t\tmissing\n    requires\n      \u251c\u2500 \u001b[32m[+]\u001b[0m network/immich-internal.network\t\tmissing\n      \u2514\u2500 \u001b[32m[+]\u001b[0m volume/immich-ml-cache.volume\t\tmissing\n    \u0394 content (17 additions)\n      + [Unit]\n"]
[0.108805, "o", "      + Description=Immich ML inference worker\n      + After=network-online.target\n      + Wants=network-online.target\n      + \n      + [Container]\n      ...\n\n\u001b[32m[+]\u001b[0m network/immich-public.network\t\t\tmissing\n    \u0394 content\n      --- previous\n      +++ desired\n      + [Unit]\n      + Description=Public-facing network shared with the edge proxy\n      + \n      + [Network]\n      + NetworkName=immich-public\n      + Subnet=198.51.100.0/24\n\n\u001b[32m[+]\u001b[0m container/immich-redis.container\t\t\tmissing\n    requires\n      \u2514\u2500 \u001b[32m[+]\u001b[0m network/immich-internal.network\t\tmissing\n    \u0394 content (17 additions)\n      + [Unit]\n      + Description=Immich Redis cache\n      + After=network-online.target\n      + Wants=network-online.target\n      + \n      + [Container]\n      ...\n\n\u001b[32m[+]\u001b[0m volume/immich-upload.volume\t\t\t\tmissing\n    \u0394 content\n      --- previous\n      +++ desired\n      + [Unit]\n      + Description=Immich upload library\n      + \n      + [Volume]\n      + VolumeName=immich-upload\n\n\u001b[32m[+]\u001b[0m container/immich-server.container\t\t\tmissing\n    requires\n      \u251c\u2500 \u001b[32m[+]\u001b[0m network/immich-internal.network\t\tmissing\n      \u251c\u2500 \u001b[32m[+]\u001b[0m network/immich-public.network\t\tmissing\n      \u2514\u2500 \u001b[32m[+]\u001b[0m volume/immich-upload.volume\t\tmissing\n    \u0394 content (27 additions)\n      + [Unit]\n      + Description=Immich photo/video server\n      + After=network-online.target immich-database.service immich-redis.service\n      + Wants=network-online.target\n      + Requires=immich-database.service immich-redis.service\n      + \n      ...\n\n\u001b[32m[+]\u001b[0m container/traefik-edge.container\t\t\tmissing\n    requires\n      \u2514\u2500 \u001b[32m[+]\u001b[0m network/immich-public.network\t\tmissing\n    \u0394 content (19 additions)\n      + [Unit]\n      + Description=Traefik edge proxy for Immich\n      + After=network-online.target immich-server.service\n      + Wants=network-online.target\n      + \n      + [Container]\n      ...\n\n\u001b[1m\u001b[37mSummary\u001b[0m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n10 creates\n\n"]
